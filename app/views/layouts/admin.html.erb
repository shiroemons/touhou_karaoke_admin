<!DOCTYPE html>
<html lang="ja" data-theme="corporate">
  <head>
    <title>東方カラオケ管理画面</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="admin-shell">
    <a class="admin-skip-link" href="#admin-main-content">本文へスキップ</a>
    <aside class="admin-sidebar">
      <%= link_to admin_root_path, class: "admin-brand" do %>
        <%= admin_icon(:dashboard) %>
        <span>東方カラオケ管理</span>
      <% end %>
      <nav class="admin-nav">
        <% main_navigation_groups, other_navigation_groups = admin_navigation_groups.partition { |group_label, _resources| group_label == "メイン" } %>
        <% main_navigation_groups.each do |group_label, resources| %>
          <section class="admin-nav-group admin-nav-group-primary" aria-label="<%= group_label %>">
            <h2><%= group_label %></h2>
            <% resources.each do |resource| %>
              <% resource_active = defined?(@resource) && @resource&.key == resource.key %>
              <%= link_to admin_resources_path(resource), class: ["admin-nav-link", "admin-nav-link-primary", ("admin-nav-link-active" if resource_active)], aria: ({ current: "page" } if resource_active) do %>
                <span class="admin-nav-icon"><%= admin_resource_icon(resource) %></span>
                <span><%= resource.label %></span>
              <% end %>
            <% end %>
          </section>
        <% end %>
        <section class="admin-nav-group" aria-label="運用">
          <h2>運用</h2>
          <% workflow_active = controller_path == "admin/workflow" %>
          <%= link_to admin_workflow_path, class: ["admin-nav-link", ("admin-nav-link-active" if workflow_active)], aria: ({ current: "page" } if workflow_active) do %>
            <span class="admin-nav-icon"><%= admin_icon(:workflow) %></span>
            <span>運用フロー</span>
          <% end %>
          <% karaoke_song_bulk_edit_active = controller_path == "admin/karaoke_song_bulk_edits" %>
          <%= link_to admin_karaoke_song_bulk_edit_path, class: ["admin-nav-link", ("admin-nav-link-active" if karaoke_song_bulk_edit_active)], aria: ({ current: "page" } if karaoke_song_bulk_edit_active) do %>
            <span class="admin-nav-icon"><%= admin_icon(:table) %></span>
            <span>カラオケ楽曲紐づけ</span>
          <% end %>
          <% karaoke_song_delivery_url_bulk_edit_active = controller_path == "admin/karaoke_song_delivery_url_bulk_edits" %>
          <%= link_to admin_karaoke_song_delivery_url_bulk_edit_path, class: ["admin-nav-link", ("admin-nav-link-active" if karaoke_song_delivery_url_bulk_edit_active)], aria: ({ current: "page" } if karaoke_song_delivery_url_bulk_edit_active) do %>
            <span class="admin-nav-icon"><%= admin_icon(:table) %></span>
            <span>カラオケ配信URL編集</span>
          <% end %>
        </section>
        <% other_navigation_groups.each do |group_label, resources| %>
          <section class="admin-nav-group" aria-label="<%= group_label %>">
            <h2><%= group_label %></h2>
            <% resources.each do |resource| %>
              <% resource_active = defined?(@resource) && @resource&.key == resource.key %>
              <%= link_to admin_resources_path(resource), class: ["admin-nav-link", ("admin-nav-link-active" if resource_active)], aria: ({ current: "page" } if resource_active) do %>
                <span class="admin-nav-icon"><%= admin_resource_icon(resource) %></span>
                <span><%= resource.label %></span>
              <% end %>
            <% end %>
          </section>
        <% end %>
      </nav>
    </aside>

    <main id="admin-main-content" class="admin-main" data-admin-page-content tabindex="-1">
      <div data-admin-flash-container>
        <% if notice.present? %>
          <div class="admin-flash admin-flash-notice alert alert-success" data-admin-flash="notice" data-admin-flash-autohide="true"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="admin-flash admin-flash-alert alert alert-error" data-admin-flash="alert"><%= alert %></div>
        <% end %>
      </div>

      <%= yield %>
    </main>
  </body>
</html>
