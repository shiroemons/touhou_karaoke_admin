<dialog class="modal admin-delete-confirmation-dialog" aria-labelledby="admin-delete-confirmation-title" aria-describedby="admin-delete-confirmation-message" data-admin-delete-confirmation-dialog>
  <div class="modal-box">
    <h2 id="admin-delete-confirmation-title" class="font-bold text-lg" data-admin-delete-confirmation-title>削除を確認</h2>
    <p id="admin-delete-confirmation-message" class="py-4" aria-live="polite" data-admin-delete-confirmation-message></p>
    <div class="modal-action">
      <button type="button" class="btn" data-admin-delete-confirmation-cancel>キャンセル</button>
      <button type="button" class="admin-button-danger btn btn-error" data-admin-delete-confirmation-confirm>削除する</button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button type="submit" aria-label="ダイアログを閉じる">閉じる</button>
  </form>
</dialog>
