<% modal = local_assigns.fetch(:modal, false) %>
<% supports_selection = record.blank? && operation.selection != :none %>
<% selection_required = operation.selection == :required %>
<% required_inputs = operation.inputs.select { |input| input.fetch(:required, true) } %>
<% submit_disabled = selection_required || required_inputs.present? %>
<% operation_progress_id = SecureRandom.uuid %>
<% operation_dom_suffix = "#{operation.key}-#{operation_progress_id}".gsub(/[^a-zA-Z0-9_-]/, '-') %>
<%= form_with url: admin_operation_path(resource, record, operation.key), method: :post, multipart: operation.inputs.any? { |input| input[:type] == :file }, class: "admin-form", data: { admin_operation_form: true, confirmation: operation.confirmation.presence || "#{operation.label}を実行します。よろしいですか？", admin_operation_action: operation.action_key, admin_operation_async: operation.async, admin_operation_estimated_seconds: operation.estimated_seconds, admin_operation_label: operation.label, admin_operation_progress_url: admin_operation_progress_path(resource, record, operation.key, operation_progress_id), admin_operation_resource_label: resource.label, admin_operation_inline_confirmation: modal, admin_operation_selection: supports_selection, admin_operation_selection_required: selection_required, admin_operation_target_scope: admin_operation_target_scope(operation, record:), admin_operation_target_label: admin_operation_target_label(operation, record:) } do |form| %>
  <%= hidden_field_tag :operation_progress_id, operation_progress_id, id: "admin-operation-progress-#{operation_dom_suffix}" %>
  <% if supports_selection %>
    <div class="admin-operation-selection-summary alert <%= selection_required ? "alert-warning" : "alert-info" %>" data-admin-operation-selection-summary role="status" aria-live="polite" aria-atomic="true">
      <strong><span data-admin-operation-selection-count>0</span>件選択中</strong>
      <span data-admin-operation-selection-note><%= selection_required ? "対象を選択してください。" : "未選択の場合は全件を対象にします。" %></span>
    </div>
    <div data-admin-operation-selected-ids></div>
  <% end %>

  <% operation.inputs.each do |input| %>
    <% input_required = input.fetch(:required, true) %>
    <% input_dom_id = "admin-operation-input-#{operation_dom_suffix}-#{input[:name]}".gsub(/[^a-zA-Z0-9_-]/, '-') %>
    <div class="admin-form-row">
      <div class="admin-form-label-row">
        <%= form.label "operation_fields_#{input[:name]}", input[:label], for: input_dom_id %>
        <span class="admin-form-requirement"><%= input_required ? "必須" : "任意" %></span>
      </div>
      <% if input[:type] == :file %>
        <%= file_field_tag "operation_fields[#{input[:name]}]", accept: input[:accept], id: input_dom_id, class: "file-input file-input-bordered w-full", required: true, data: { admin_operation_required_input: true } %>
      <% elsif input[:type] == :checkbox %>
        <label class="admin-checkbox-field">
          <%= hidden_field_tag "operation_fields[#{input[:name]}]", "0", id: nil %>
          <%= check_box_tag "operation_fields[#{input[:name]}]", "1", input.fetch(:checked, false), id: input_dom_id, class: "checkbox checkbox-sm" %>
          <span><%= input[:description].presence || input[:label] %></span>
        </label>
      <% else %>
        <%= text_field_tag "operation_fields[#{input[:name]}]", nil, id: input_dom_id, placeholder: input[:placeholder], class: "admin-input input input-bordered w-full", required: true, data: { admin_operation_required_input: true } %>
      <% end %>
    </div>
  <% end %>

  <div class="admin-form-actions">
    <% if modal %>
      <button type="button" class="admin-button btn" aria-label="<%= operation.label %>をキャンセル" data-admin-operation-modal-cancel>キャンセル</button>
    <% end %>
    <%= button_tag type: :submit, class: "admin-button admin-button-primary btn btn-primary", disabled: submit_disabled, aria: { label: "#{operation.label}を実行", describedby: "admin-operation-submit-note-#{operation_progress_id}" }, data: { admin_operation_submit: true } do %>
      <%= admin_icon(operation.inputs.any? { |input| input[:type] == :file } ? :upload : :action) %>
      <span>実行</span>
    <% end %>
  </div>
  <p class="admin-operation-submit-note" id="admin-operation-submit-note-<%= operation_progress_id %>" data-admin-operation-submit-note role="status" aria-live="polite" aria-atomic="true">
    <% if selection_required %>
      対象を選択すると実行できます。
    <% elsif required_inputs.present? %>
      必須項目を入力すると実行できます。
    <% else %>
      内容を確認して実行できます。
    <% end %>
  </p>

  <div class="admin-operation-progress" aria-busy="false" data-admin-operation-progress hidden>
    <div class="admin-operation-progress-header">
      <div>
        <span class="admin-operation-progress-kicker">処理進捗</span>
        <strong data-admin-operation-progress-label>処理を開始しています...</strong>
      </div>
      <div class="admin-operation-progress-meta">
        <span data-admin-operation-progress-percent>0%</span>
        <span data-admin-operation-progress-elapsed>00:00</span>
        <span data-admin-operation-progress-status>待機中</span>
      </div>
    </div>
    <div class="admin-operation-progress-track" role="progressbar" aria-label="<%= operation.label %>の進捗" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="待機中 0%" data-admin-operation-progressbar>
      <div class="admin-operation-progress-bar" data-admin-operation-progress-bar></div>
    </div>
    <ol class="admin-operation-progress-steps" aria-label="処理ステップ">
      <li data-admin-operation-step="prepare" class="admin-operation-progress-step admin-operation-progress-step-active">入力内容を確認</li>
      <li data-admin-operation-step="execute" class="admin-operation-progress-step">外部サイト取得・保存</li>
      <li data-admin-operation-step="finish" class="admin-operation-progress-step">結果を反映</li>
    </ol>
    <p class="admin-operation-progress-note">処理側から取得できる件数またはページ数を優先して表示します。総件数を取得できない処理では、ページ数と処理件数から進捗率を推測します。</p>
    <p class="admin-sr-only" role="status" aria-live="polite" aria-atomic="true" data-admin-operation-progress-announcement></p>
  </div>
<% end %>
