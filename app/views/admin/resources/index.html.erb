<% selectable_collection_operations = @resource.operations.any? { |operation| operation.scope == :collection && operation.selection != :none } %>
<div class="admin-index-content" data-admin-resource-content aria-busy="false" tabindex="-1">
<header class="admin-page-header">
  <div>
    <h1><%= @resource.label %></h1>
    <p class="admin-page-count">総件数 <strong><%= number_with_delimiter(@total_count) %></strong> 件</p>
  </div>
  <div class="admin-header-actions">
    <% if @resource.key == :song %>
      <%= link_to admin_karaoke_song_bulk_edit_path, class: "admin-button btn" do %>
        <%= admin_icon(:table) %>
        <span>カラオケ楽曲紐づけ</span>
      <% end %>
      <%= link_to admin_karaoke_song_delivery_url_bulk_edit_path, class: "admin-button btn" do %>
        <%= admin_icon(:table) %>
        <span>カラオケ配信URL編集</span>
      <% end %>
    <% end %>
    <% if policy(@resource.model).create? %>
      <%= link_to new_admin_resource_path(@resource), class: "admin-button admin-button-primary btn btn-primary" do %>
        <%= admin_icon(:create) %>
        <span>新規作成</span>
      <% end %>
    <% end %>
  </div>
</header>

<%= render "operations", resource: @resource, record: nil %>

<div class="admin-index-toolbar">
  <%= form_with url: admin_resources_path(@resource), method: :get, class: "admin-query-panel admin-control-panel", data: { admin_filter_form: true } do |form| %>
    <%= form.hidden_field :view_mode, value: @view_mode, id: "admin-query-view-mode" %>
    <%= hidden_field_tag :sort, params[:sort], id: "admin-query-sort" if params[:sort].present? %>
    <%= hidden_field_tag :direction, params[:direction], id: "admin-query-direction" if params[:direction].present? %>
    <%= hidden_field_tag :per_page, @per_page, id: "admin-query-per-page" if @view_mode == "paginated" %>

    <div class="admin-search-row">
      <label class="admin-search-field input input-bordered">
        <span class="admin-sr-only">キーワード</span>
        <%= admin_icon(:search) %>
        <%= form.search_field :q, value: params[:q], placeholder: "キーワード検索", class: "admin-input admin-input-plain", aria: { label: "#{@resource.label}をキーワード検索" } %>
      </label>
      <%= button_tag type: :submit, class: "admin-button btn" do %>
        <%= admin_icon(:search) %>
        <span>検索</span>
      <% end %>
      <%= link_to admin_resources_path(@resource), class: "admin-button btn btn-ghost" do %>
        <%= admin_icon(:clear) %>
        <span>クリア</span>
      <% end %>
    </div>

    <% if @resource.filters.present? %>
      <details class="admin-filter-disclosure" <%= "open" if @active_filters.present? %>>
        <summary class="admin-filter-summary">
          <%= admin_icon(:filter) %>
          <span>絞り込み</span>
          <% if @active_filters.present? %>
            <span class="admin-filter-active-count"><%= @active_filters.size %>件指定中</span>
          <% end %>
          <%= admin_icon(:disclosure, class: "admin-filter-summary-icon") %>
        </summary>
        <div class="admin-filter-list">
          <% @resource.filters.each do |filter| %>
            <div class="<%= admin_filter_field_class(filter).compact.join(" ") %>">
              <span><%= filter.label %></span>
              <%= admin_filter_control(filter, @active_filters[filter.name.to_s]) %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  <% end %>
</div>

<div class="admin-table-controls">
  <div class="admin-result-summary" data-admin-result-summary data-total-count="<%= @total_count %>" role="status" aria-live="polite" aria-atomic="true">
    <span>表示中 <strong data-admin-visible-count><%= number_with_delimiter(@records.size) %></strong> / <%= number_with_delimiter(@total_count) %> 件</span>
  </div>
  <%= render "display_settings" %>
</div>

<% if selectable_collection_operations %>
  <div class="admin-selection-toolbar alert alert-info" data-admin-selection-toolbar role="status" aria-live="polite" aria-atomic="true">
    <%= admin_icon(:select) %>
    <div>
      <strong><span data-admin-selection-count>0</span>件選択中</strong>
      <span data-admin-selection-note>一括操作を実行するには、対象行を選択してください。</span>
    </div>
    <button type="button" class="admin-button btn btn-sm btn-ghost" data-admin-resource-selection-clear disabled>
      <%= admin_icon(:clear) %>
      <span>選択解除</span>
    </button>
  </div>
<% end %>

<div class="admin-table-wrap" tabindex="0" role="region" aria-label="<%= @resource.label %>一覧">
  <table class="admin-table admin-table-resource-<%= @resource.key.to_s.dasherize %> table table-zebra">
    <caption class="admin-sr-only"><%= @resource.label %>一覧</caption>
    <thead>
      <tr>
        <% if selectable_collection_operations %>
          <th class="admin-select-column admin-table-field" scope="col">
            <label class="admin-row-select-all">
              <%= check_box_tag "select_all_#{@resource.key}", "1", false, class: "checkbox checkbox-sm", data: { admin_resource_select_all: true }, aria: { label: "表示中の#{@resource.label}を選択", checked: "false" } %>
              <span>選択</span>
            </label>
          </th>
        <% end %>
        <% @resource.index_fields.each do |field| %>
          <% sort_order = field.sortable ? admin_sort_order(field) : nil %>
          <th class="admin-table-field admin-table-field-<%= field.name.to_s.delete_suffix("?").dasherize %>" scope="col" <%= tag.attributes(aria: { sort: sort_order || "none" }) if field.sortable %>>
            <% if field.sortable %>
              <%= admin_sort_link(@resource, field) %>
            <% else %>
              <%= field.label %>
            <% end %>
          </th>
        <% end %>
        <th class="admin-actions-column admin-table-field admin-table-field-actions" scope="col">操作</th>
      </tr>
    </thead>
    <tbody id="admin-resource-rows">
      <%= render "rows" %>
    </tbody>
  </table>
  <% if @records.empty? %>
    <div class="admin-empty-state alert" role="status">
      <%= admin_icon(:search) %>
      <div>
        <p><%= admin_empty_index_title(@resource, @active_filters) %></p>
        <span><%= admin_empty_index_description(@resource, @active_filters) %></span>
      </div>
      <% if admin_filtered_index?(@active_filters) %>
        <%= link_to admin_resources_path(@resource), class: "admin-button btn btn-ghost" do %>
          <%= admin_icon(:clear) %>
          <span>条件をクリア</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% unless @view_mode == "paginated" %>
    <div
      class="admin-infinite-scroll"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      aria-busy="false"
      data-admin-infinite-scroll
      data-next-url="<%= @next_infinite_scroll_url %>"
      <%= "hidden" if @next_infinite_scroll_url.blank? %>>
      <span class="admin-infinite-scroll-status" data-admin-infinite-scroll-status>さらに読み込みます</span>
      <button type="button" class="admin-button btn btn-sm btn-ghost" data-admin-infinite-scroll-retry hidden>再試行</button>
    </div>
  <% end %>
</div>

<%= render "operation_modal", resource: @resource, operations: @resource.operations %>

<% if @view_mode == "paginated" %>
  <nav class="admin-pagination" aria-label="<%= @resource.label %>のページ移動">
    <% if @page > 1 %>
      <%= link_to admin_resources_path(@resource, admin_page_params(@page - 1)), class: "admin-button btn" do %>
        <%= admin_icon(:back) %>
        <span>前へ</span>
      <% end %>
    <% end %>
    <span aria-current="page"><%= @page %> / <%= @total_pages %></span>
    <% if @page < @total_pages %>
      <%= link_to admin_resources_path(@resource, admin_page_params(@page + 1)), class: "admin-button btn" do %>
        <span>次へ</span>
        <%= admin_icon(:next) %>
      <% end %>
    <% end %>
  </nav>
<% end %>
</div>
