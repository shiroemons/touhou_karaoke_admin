{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": {
    "postgresql_18": "18.4",
    "libyaml":       "0.2.5",
    "openssl_3_6":   "3.6.3",
    "zlib":          "1.3.2",
    "readline":      "8.3p3",
    "libffiReal":    "3.7.1",
    "chromedriver": {
      "version":            "151.0.7922.71",
      "excluded_platforms": ["aarch64-darwin"]
    },
    "chromium": {
      "version":            "151.0.7922.71",
      "excluded_platforms": ["aarch64-darwin"]
    },
    "libpq": "18.4",
    "ruby": {
      "version":            "4.0.6",
      "excluded_platforms": ["x86_64-darwin"]
    },
    "corepack": "0.35.0",
    "nodejs-slim": "24.18.1"
  },
  "env": {
    "BUNDLE_PATH":        ".devbox/virtenv/bundle-ruby-4.0.6",
    "GEM_HOME":           ".devbox/virtenv/gems",
    "BOOTSNAP_CACHE_DIR": ".devbox/virtenv/bootsnap-ruby-4.0.6",
    "PGHOST":             "/tmp",
    "PGPORT":             "5432",
    "PGUSER":             "postgres",
    "PGPASSWORD":         "postgres",
    "PGGSSENCMODE":       "disable",
    "RAILS_ENV":          "development",
    "BUNDLER_VERSION":    "4.0.18"
  },
  "env_from": ".env",
  "shell": {
    "init_hook": [
      "echo '東方カラオケ検索管理サイト - devbox環境'",
      "mkdir -p \"$BUNDLE_PATH\" \"$GEM_HOME\" \"$BOOTSNAP_CACHE_DIR\"",
      "export PATH=\"$GEM_HOME/bin:$PATH\"",
      "if [ \"$(uname -s)\" = \"Darwin\" ] && [ -x \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" ]; then export CHROME_PATH=\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\"; elif command -v chromium > /dev/null; then export CHROME_PATH=\"$(command -v chromium)\"; fi",
      "if ! gem list bundler -i -v \"$BUNDLER_VERSION\" > /dev/null; then gem install bundler -v \"$BUNDLER_VERSION\" --no-document; fi"
    ],
    "scripts": {
      "setup":               "bundle config unset bin && bundle install --jobs=4 && yarn install --immutable && bin/rails db:prepare",
      "server":              "rm -f tmp/pids/server.pid && bin/rails server -b 0.0.0.0",
      "jobs":                "bin/jobs start",
      "console":             "bin/rails console",
      "console:sandbox":     "bin/rails console --sandbox",
      "bundle":              "bundle config unset bin && bundle config set clean true && bundle install --jobs=4",
      "db:init":             "bin/rails db:drop db:setup",
      "db:console":          "bin/rails dbconsole",
      "db:migrate":          "bin/rails db:migrate",
      "db:migrate:redo":     "bin/rails db:migrate:redo",
      "db:rollback":         "bin/rails db:rollback",
      "db:seed":             "bin/rails db:seed",
      "db:backup":           "mkdir -p tmp/data && pg_dump -Fc --no-owner -d touhou_karaoke_admin_development -f tmp/data/dev.bak",
      "db:restore":          "pg_restore --no-privileges --no-owner --clean -d touhou_karaoke_admin_development ./tmp/data/dev.bak",
      "test":                "env SKIP_JS_BUILD=1 SKIP_CSS_BUILD=1 SKIP_YARN_INSTALL=1 RAILS_ENV=test bin/rails db:test:prepare && env SKIP_JS_BUILD=1 SKIP_CSS_BUILD=1 SKIP_YARN_INSTALL=1 RAILS_ENV=test bin/rails test",
      "test:assets":         "yarn build:css && yarn build",
      "rubocop":             "bundle exec rubocop --parallel",
      "rubocop:fix":         "bundle exec rubocop --autocorrect",
      "rubocop:fix:all":     "bundle exec rubocop --autocorrect-all",
      "export:algolia":      "bin/rails runner lib/export_songs.rb",
      "check:algolia":       "bin/rails runner lib/check_algolia_upload.rb --verbose --output-changes tmp/karaoke_songs.json",
      "export:karaoke":      "bin/rails runner lib/export_karaoke_songs.rb",
      "import:karaoke":      "bin/rails runner lib/import_karaoke_songs.rb",
      "export:artists":      "bin/rails runner lib/export_display_artists_with_circles.rb",
      "import:artists":      "bin/rails runner lib/import_display_artists_with_circles.rb",
      "import:touhou":       "bin/rails runner lib/import_touhou_music.rb",
      "import:touhou:slim":  "bin/rails runner lib/import_touhou_music_slim.rb",
      "check:joysound":      "bin/rails runner lib/check_expired_joysound_utasuki.rb --verbose",
      "delete:joysound":     "bin/rails runner lib/check_expired_joysound_utasuki.rb --delete --verbose",
      "stats":               "bin/rails runner lib/stats.rb",
      "data:duplicates":     "bin/rails data_integrity:duplicate_report",
      "update:originals":    "bin/rails db:seed:update_originals",
      "seed:originals":      "bin/rails db:seed:originals",
      "seed:original_songs": "bin/rails db:seed:original_songs",
      "seed:originals:all":  "bin/rails db:seed:originals_all"
    }
  }
}
